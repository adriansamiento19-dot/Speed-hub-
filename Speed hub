status.TextColor3 = Color3.fromRGB(180, 180, 195)
status.Font = Enum.Font.Gotham
status.TextSize = 13
status.Parent = body

-- Button logic (the server does the actual speed change)
local function readSpeed()
	local n = tonumber(box.Text)
	if n then
		targetSpeed = math.clamp(n, 0, MAX_SPEED)
		box.Text = tostring(targetSpeed)
		return true
	end
	status.Text = "Type a number first"
	return false
end

setBtn.MouseButton1Click:Connect(function()
	if readSpeed() then
		remote:FireServer(targetSpeed, autoOn, true)
		status.Text = "Speed set: " .. targetSpeed
	end
end)

autoBtn.MouseButton1Click:Connect(function()
	if not autoOn then
		if not readSpeed() then return end
		autoOn = true
		remote:FireServer(targetSpeed, true, true)
		autoBtn.Text = "Auto: ON"
		autoBtn.BackgroundColor3 = Color3.fromRGB(50, 170, 80)
		status.Text = "Auto locking: " .. targetSpeed
	else
		autoOn = false
		remote:FireServer(targetSpeed, false, false)
		autoBtn.Text = "Auto: OFF"
		autoBtn.BackgroundColor3 = Color3.fromRGB(170, 55, 55)
		status.Text = "Auto off"
	end
end)

box.FocusLost:Connect(function()
	if autoOn and readSpeed() then
		remote:FireServer(targetSpeed, true, true)
		status.Text = "Auto locking: " .. targetSpeed
	end
end)

local minimized = false
minBtn.MouseButton1Click:Connect(function()
	minimized = not minimized
	body.Visible = not minimized
	main.Size = minimized and UDim2.new(0, 220, 0, 30) or UDim2.new(0, 220, 0, 144)
	minBtn.Text = minimized and "+" or "-"
end)

-- Dragging
local dragging, dragStart, startPos
title.InputBegan:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1
		or input.UserInputType == Enum.UserInputType.Touch then
		dragging = true
		dragStart = input.Position
		startPos = main.Position
		input.Changed:Connect(function()
			if input.UserInputState == Enum.UserInputState.End then
				dragging = false
			end
		end)
	end
end)

UserInputService.InputChanged:Connect(function(input)
	if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement
		or input.UserInputType == Enum.UserInputType.Touch) then
		local d = input.Position - dragStart
		main.Position = UDim2.new(
			startPos.X.Scale, startPos.X.Offset + d.X,
			startPos.Y.Scale, startPos.Y.Offset + d.Y
		)
	end
end)
