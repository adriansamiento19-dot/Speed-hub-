-- Speed Hub (ONE script)
-- Put this in ServerScriptService as a Script (leave RunContext on Legacy).
-- It runs the server part itself, then sends a copy of itself to each admin
-- which runs on their client and shows the menu.

local RunService = game:GetService("RunService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local UserInputService = game:GetService("UserInputService")

-- Put your UserId (and any other admins) here
local ADMINS = {
	[123456789] = true, -- REPLACE with your UserId
}
local MAX_SPEED = 500

----------------------------------------------------------------
-- SERVER
----------------------------------------------------------------
if RunService:IsServer() then
	local remote = Instance.new("RemoteEvent")
	remote.Name = "SpeedHubRemote"
	remote.Parent = ReplicatedStorage

	local data = {} -- [player] = { speed = number, auto = boolean }
	local conns = {} -- [player] = RBXScriptConnection

	local function isAdmin(player)
		if ADMINS[player.UserId] then return true end
		if game.CreatorType == Enum.CreatorType.User and player.UserId == game.CreatorId then
			return true
		end
		return false
	end

	local function getHumanoid(player)
		local char = player.Character
		return char and char:FindFirstChildOfClass("Humanoid")
	end

	-- while Auto is on, anything that changes this admin's speed gets put back
	local function hook(player)
		if conns[player] then
			conns[player]:Disconnect()
			conns[player] = nil
		end
		local d = data[player]
		local hum = getHumanoid(player)
		if not (d and d.auto and hum) then return end
		conns[player] = hum:GetPropertyChangedSignal("WalkSpeed"):Connect(function()
			if d.auto and hum.WalkSpeed ~= d.speed then
				hum.WalkSpeed = d.speed
			end
		end)
	end

	local function onCharacter(player, char)
		local hum = char:WaitForChild("Humanoid", 10)
		if not hum then return end
		local d = data[player]
		if d and d.auto then
			hum.WalkSpeed = d.speed
		end
		hook(player)
	end

	-- sends a copy of this script to the admin; it runs on their client as the menu
	local function giveMenu(player)
		local playerGui = player:WaitForChild("PlayerGui", 15)
		if not playerGui then return end
		if playerGui:FindFirstChild("SpeedHubMenu") then return end
		local copy = script:Clone()
		copy.Name = "SpeedHubMenu"
		copy.RunContext = Enum.RunContext.Client
		copy.Parent = playerGui
	end

	local function setupPlayer(player)
		local admin = isAdmin(player)
		player:SetAttribute("SpeedHubAdmin", admin)
		if not admin then return end

		data[player] = { speed = 16, auto = false }
		player.CharacterAdded:Connect(function(char)
			onCharacter(player, char)
		end)
		if player.Character then
			task.spawn(onCharacter, player, player.Character)
		end
		task.spawn(giveMenu, player)
	end

	remote.OnServerEvent:Connect(function(player, speed, auto, apply)
		if not isAdmin(player) then return end
		local d = data[player]
		if not d then return end
		if typeof(speed) ~= "number" or speed ~= speed then return end
		if typeof(auto) ~= "boolean" then return end

		d.speed = math.clamp(speed, 0, MAX_SPEED)
		d.auto = auto

		if apply == true then
			local hum = getHumanoid(player)
			if hum then
				hum.WalkSpeed = d.speed
			end
		end
		hook(player)
	end)

	Players.PlayerAdded:Connect(setupPlayer)
	for _, p in ipairs(Players:GetPlayers()) do
		setupPlayer(p)
	end

	Players.PlayerRemoving:Connect(function(player)
		if conns[player] then
			conns[player]:Disconnect()
			conns[player] = nil
		end
		data[player] = nil
	end)

	return
end

----------------------------------------------------------------
-- CLIENT (the menu, runs from the copy the server sends)
----------------------------------------------------------------
